    { "Click to open the OptiScaler Wiki page\nin your default browser\n\nCompatibility list with known game issues\nand workarounds, FG options explained\nand other useful info", "\352\270\260\353\263\270 \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 OptiScaler \354\234\204\355\202\244 \355\216\230\354\235\264\354\247\200\353\245\274 \354\227\275\353\213\210\353\213\244\n\354\260\275\354\227\220\354\204\234 \354\227\264\353\246\275\353\213\210\353\213\244\n\n\354\225\214\353\240\244\354\247\204 \352\262\214\354\236\204 \353\254\270\354\240\234\354\231\200 \355\225\264\352\262\260 \353\260\251\353\262\225,\nFG \354\230\265\354\205\230 \354\204\244\353\252\205,\n\352\270\260\355\203\200 \354\234\240\354\232\251\355\225\234 \354\240\225\353\263\264\353\245\274 \355\231\225\354\235\270\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244" },
