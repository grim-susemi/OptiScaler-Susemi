    { "Compare, debug view and skin-mask inspection suspend the separate edit-upscale path.", "\353\271\204\352\265\220, \353\224\224\353\262\204\352\267\270 \353\263\264\352\270\260, \355\224\274\353\266\200 \353\247\210\354\212\244\355\201\254 \352\262\200\354\202\254\353\212\224 \353\263\204\353\217\204 \355\216\270\354\247\221 \354\227\205\354\212\244\354\274\200\354\235\274 \352\262\275\353\241\234\353\245\274 \354\244\221\353\213\250\354\213\234\355\202\265\353\213\210\353\213\244." },
    { "Consider renaming OptiScaler from %s to other supported name.\nYou may experience issues otherwise.", "%s\354\227\220\354\204\234 OptiScaler\353\245\274 \353\213\244\353\245\270 \354\247\200\354\233\220 \354\235\264\353\246\204\354\234\274\353\241\234 \353\263\200\352\262\275\355\225\230\353\212\224 \352\262\203\354\235\204 \352\263\240\353\240\244\355\225\230\354\204\270\354\232\224.\n\352\267\270\353\240\207\354\247\200 \354\225\212\354\234\274\353\251\264 \353\254\270\354\240\234\352\260\200 \353\260\234\354\203\235\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244." },
